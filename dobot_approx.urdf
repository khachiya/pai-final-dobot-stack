<?xml version="1.0"?>
<robot name="dobot_approx">
  <link name="base"><inertial><mass value="1.0"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" izx="0" iyz="0" izz="0.001"/></inertial>
    <visual><geometry><cylinder radius="0.055" length="0.1"/><origin xyz="0 0 0.05"/></geometry></visual>
    <collision><geometry><cylinder radius="0.055" length="0.1"/><origin xyz="0 0 0.05"/></geometry></collision></link>
  <link name="shoulder"><inertial><mass value="0.15"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" izx="0" iyz="0" izz="0.0001"/></inertial>
    <visual><geometry><box size="0.04 0.05 0.05"/><origin xyz="0.01 0 0"/></geometry></visual></link>
  <link name="upperarm"><inertial><mass value="0.3"/><inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" izx="0" iyz="0" izz="0.0002"/></inertial>
    <visual><geometry><box size="0.135 0.03 0.03"/><origin xyz="0.0675 0 0"/></geometry></visual></link>
  <link name="forearm"><inertial><mass value="0.2"/><inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" izx="0" iyz="0" izz="0.0001"/></inertial>
    <visual><geometry><box size="0.16 0.025 0.025"/><origin xyz="0.08 0 0"/></geometry></visual></link>
  <link name="tool"><inertial><mass value="0.08"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" izx="0" iyz="0" izz="0.00005"/></inertial>
    <visual><geometry><cylinder radius="0.016" length="0.05"/><origin xyz="0 0 -0.025"/></geometry></visual></link>

  <joint name="j1" type="revolute"><parent link="base"/><child link="shoulder"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="30" velocity="3"/></joint>
  <joint name="j2" type="revolute"><parent link="shoulder"/><child link="upperarm"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.8" upper="2.8" effort="30" velocity="3"/></joint>
  <joint name="j3" type="revolute"><parent link="upperarm"/><child link="forearm"/>
    <origin xyz="0.135 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.8" upper="2.8" effort="30" velocity="3"/></joint>
  <joint name="j4" type="revolute"><parent link="forearm"/><child link="tool"/>
    <origin xyz="0.16 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-6.0" upper="6.0" effort="10" velocity="6"/></joint>
</robot>